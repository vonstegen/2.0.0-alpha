{
  "id": "addon.resonant-terminal-iterm2",
  "name": "Resonant iTerm2 Terminal Host",
  "version": "0.1.0",
  "author": "ResonantOS",
  "category": "integration",
  "sdkVersion": "0.1.0",
  "description": "iTerm2 reference terminal host adapter. Registers iTerm2 as a replaceable terminal host so harness add-ons (Pi/OMP/Codex) run in a managed iTerm2 session under ROS session/resource/authority control.",
  "runtimeType": "local-service",
  "surfaces": [
    {
      "id": "iterm2-terminal-host",
      "type": "panel",
      "label": "iTerm2 Terminal Host",
      "description": "Manage iTerm2 terminal sessions from ResonantOS."
    }
  ],
  "requestedCapabilities": [
    {
      "capability": "terminal-host",
      "granted": false,
      "scope": "system",
      "revocationBehavior": "degrade"
    }
  ],
  "provenance": {
    "tier": "sideloaded-unverified",
    "verificationState": "unverified",
    "signed": false
  },
  "runtimeIsolation": {
    "boundary": "host-mediated-service",
    "supportsDegradedMode": true,
    "requiresReviewedGrant": true
  },
  "grantPresets": [
    {
      "id": "iterm2-terminal-host",
      "label": "iTerm2 terminal host",
      "description": "Grant the adapter the terminal-host capability so it can manage iTerm2 sessions.",
      "grants": [
        {
          "capability": "terminal-host",
          "granted": true,
          "scope": "system",
          "revocationBehavior": "degrade"
        }
      ]
    }
  ],
  "providerRequirements": {
    "sharedProfiles": [],
    "supportsPrivateCredentials": false
  },
  "archiveIntegration": {
    "readScopes": [],
    "intakeWriteScopes": [],
    "canRequestIngest": false,
    "canWriteKnowledgePages": false
  },
  "health": {
    "strategy": "stdio-json-rpc"
  },
  "installHooks": {},
  "service": {
    "protocol": "stdio-json-rpc",
    "entrypoint": "python3 adapter.py"
  },
  "embeddedWorkspace": {
    "surfaceId": "iterm2-terminal-host",
    "mode": "terminal",
    "autoStart": false,
    "settingsVisibility": "visible",
    "requiredCapabilities": ["terminal-host"]
  },
  "compatibility": {
    "shellVersion": "^0.1.0",
    "platforms": ["macOS"]
  }
}
