{
  "archiveIntegration": {
    "canRequestIngest": false,
    "canWriteKnowledgePages": false,
    "intakeWriteScopes": [],
    "readScopes": []
  },
  "augmentorExtension": {
    "approvalGates": [
      "human-approval"
    ],
    "auditLogRequired": true,
    "compatible": {
      "augmentorVersions": [
        "^0.1.0"
      ],
      "sdkVersions": [
        "^0.1.0"
      ]
    },
    "contextPolicy": {
      "read": [],
      "write": []
    },
    "failureBehavior": "fail-closed",
    "kind": "tool",
    "producesDelegationPackets": false,
    "requiredCapabilities": [
      "archive-read"
    ],
    "requiredTools": [
      "augmentor.summarize-diff"
    ],
    "revocationBehavior": "cancel",
    "verificationHooks": [],
    "workflowPhases": []
  },
  "author": "Resonant Alpha",
  "category": "tool",
  "compatibility": {
    "platforms": [
      "macOS",
      "linux",
      "windows"
    ],
    "shellVersion": "2.0.0-beta.1"
  },
  "description": "Conformance example: a focused Augmentor extension of kind tool that summarizes a file diff into a review note under a human approval gate.",
  "extensionClass": "augmentor-extension",
  "health": {
    "strategy": "none"
  },
  "id": "addon.augmentor-tool-example",
  "installHooks": {},
  "name": "Augmentor Tool Example",
  "provenance": {
    "signed": false,
    "tier": "sideloaded-unverified",
    "verificationState": "unverified"
  },
  "providerRequirements": {
    "sharedProfiles": [],
    "supportsPrivateCredentials": false
  },
  "publisher": "local",
  "requestedCapabilities": [
    {
      "capability": "archive-read",
      "granted": false,
      "revocationBehavior": "degrade",
      "scope": "shared"
    }
  ],
  "runtimeIsolation": {
    "boundary": "shell-ui",
    "requiresReviewedGrant": false,
    "supportsDegradedMode": true
  },
  "runtimeType": "ui-module",
  "sdkVersion": "^2.0.x",
  "surfaces": [
    {
      "description": "Dockable panel proving a tool extension can declare a shell surface.",
      "id": "augmentor-tool-example-panel",
      "label": "Augmentor Tool Example",
      "shellNavigation": {
        "dockIcon": "augmentor-tool-example",
        "eyebrow": "Augmentor",
        "order": 503,
        "sectionId": "augmentor-tool-example"
      },
      "type": "panel"
    }
  ],
  "tools": [
    {
      "audit": {
        "artifactTypes": [
          "summary"
        ],
        "logRequest": false,
        "logResult": false
      },
      "description": "Summarize a file diff into a review note.",
      "inputSchema": {
        "properties": {
          "diff": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "augmentor.summarize-diff",
      "outputSchema": {
        "properties": {
          "summary": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "requiredCapabilities": [
        "archive-read"
      ],
      "requiresHumanApproval": true
    }
  ],
  "version": "0.1.0"
}
