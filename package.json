{
  "name": "resonantos-vnext",
  "version": "2.0.0-beta.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1430 --strictPort",
    "build": "tsc && vite build --target es2022",
    "preview": "vite preview",
    "test": "vitest run",
    "memory-service": "node examples/living-archive-memory-service.mjs",
    "test:living-archive-mcp": "node --test examples/living-archive-mcp.test.mjs",
    "test:living-archive-memory-service": "node --test examples/living-archive-memory-service.test.mjs",
    "test:browser-host": "node --test addons/resonant-browser-host/test/*.test.mjs",
    "test:browser-first": "node scripts/run-browser-first-extension-tests.mjs",
    "test:browser-first:live": "node browser-first/test/agent-control-live.mjs",
    "browser-first:dev": "node run-bridge-minimal.mjs",
    "browser-first:bridge": "node run-bridge-minimal.mjs",
    "cft:extension": "node scripts/launch-cft-extension.mjs",
    "cft:stable": "node scripts/launch-cft-extension.mjs --stable",
    "cft:icon": "node scripts/cft-extension-icon.mjs",
    "release:extension": "node scripts/release-extension.mjs",
    "health": "node scripts/health-check.mjs",
    "test:health": "node --test --test-concurrency=1 scripts/health-check.test.mjs",
    "engineer:prompt": "node scripts/engineer-runner.mjs prompt",
    "engineer:verify": "node scripts/engineer-runner.mjs verify",
    "test:engineer-runner": "node --test scripts/engineer-runner.test.mjs",
    "test:security-pipeline": "node --test scripts/security-pipeline/checks/*.test.mjs scripts/security-pipeline/disclosure-baseline.test.mjs",
    "test:module-ownership": "node --test scripts/module-ownership-doc.test.mjs",
    "discipline:validate": "node scripts/validate-discipline-catalog.mjs",
    "validate:manifest": "npx tsx scripts/validate-addon-manifest.mjs",
    "repo:hygiene": "node scripts/check-repo-hygiene.mjs --content-allowlist scripts/check-repo-hygiene.mjs --content-allowlist scripts/check-repo-hygiene.test.mjs --content-allowlist scripts/validate-docs.test.mjs",
    "docs:check": "node scripts/validate-docs.mjs",
    "test:recipes": "node --test scripts/recipe-doc-fixtures.test.mjs",
    "test:docs": "node --test --test-concurrency=1 scripts/validate-docs.test.mjs scripts/check-repo-hygiene.test.mjs scripts/browser-first-release-scope-audit.test.mjs scripts/project-sync-policy.test.mjs scripts/roadmap-project-consistency.test.mjs scripts/verify-alpha.test.mjs scripts/recipe-doc-fixtures.test.mjs",
    "project:check-roadmap": "node scripts/check-roadmap-project.mjs",
    "verify:alpha": "node scripts/verify-alpha.mjs",
    "pre-release:scan": "bash scripts/pre-release-scan.sh",
    "browser-first:audit-scope": "node scripts/browser-first-release-scope-audit.mjs",
    "browser-first:audit-scope:staged": "node scripts/browser-first-release-scope-audit.mjs --staged --strict",
    "test:external-agent-runtime": "node --test browser-first/test/external-agent-runtime-dispatcher.test.mjs",
    "test:phase35": "node --test browser-first/test/bridge-attributed-token.test.mjs browser-first/test/bridge-grants-store.test.mjs browser-first/test/bridge-audit-ledger.test.mjs browser-first/test/bridge-denied-audit.test.mjs browser-first/test/bridge-caller-attributed-integration.test.mjs",
    "deepseek-harness:smoke": "npx tsx scripts/run-deepseek-smoke.mjs",
    "addon:bench": "npx tsx scripts/addon-bench.mjs",
    "cordis-stub:start": "node examples/fixtures/cordis-stub.mjs",
    "bench:build": "docker compose -f docker-compose.bench.yml build",
    "bench:up": "docker compose -f docker-compose.bench.yml up -d && sleep 2 && docker compose -f docker-compose.bench.yml logs",
    "bench:up:fg": "docker compose -f docker-compose.bench.yml up",
    "bench:down": "docker compose -f docker-compose.bench.yml down",
    "bench:reset": "docker compose -f docker-compose.bench.yml down --volumes && docker compose -f docker-compose.bench.yml build",
    "bench:roundtrip": "docker compose -f docker-compose.bench.yml exec bench /app/bench/roundtrip.mjs",
    "bench:panel": "echo 'open http://127.0.0.1:47773/dev/external-agent-runtimes/' && open http://127.0.0.1:47773/dev/external-agent-runtimes/"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "entities": "^8.0.0",
    "jsdom": "^29.0.2",
    "parse5": "^8.0.1",
    "playwright": "^1.59.1",
    "remark-parse": "^11.0.0",
    "semver": "^7.8.5",
    "typescript": "^5.0.0",
    "unified": "^11.0.5",
    "vite": "^6.4.2",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
