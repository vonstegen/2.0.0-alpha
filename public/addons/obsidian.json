{
  "archiveIntegration": {
    "canRequestIngest": true,
    "canWriteKnowledgePages": false,
    "intakeWriteScopes": [
      "obsidian-vault-notes"
    ],
    "readScopes": [
      "living-archive/context",
      "vault"
    ]
  },
  "author": "Resonant Alpha",
  "category": "knowledge",
  "compatibility": {
    "platforms": [
      "macOS",
      "windows",
      "linux"
    ],
    "shellVersion": "^2.0.0-beta.1"
  },
  "connectors": [
    {
      "configScope": "user-config",
      "description": "Connects a user-selected markdown or Obsidian vault to ResonantOS through audited filesystem operations.",
      "id": "markdown-vault",
      "name": "Markdown vault",
      "requiredCapabilities": [
        "filesystem"
      ],
      "type": "filesystem"
    }
  ],
  "delegation": {
    "acceptsTasks": true,
    "artifactReturnTypes": [
      "summary",
      "markdown",
      "file-list",
      "archive-intake-bundle"
    ],
    "defaultTargetRuntime": "embedded-workspace",
    "notes": [
      "Resonant Notes is primarily a user workspace in v1.",
      "Delegated organization proposals must not move or rewrite vault content without user approval."
    ],
    "requiresHumanApprovalBeforeExecution": true,
    "taskTypes": [
      "knowledge-organization",
      "archive-prep"
    ]
  },
  "description": "Opens an Obsidian-compatible markdown vault inside ResonantOS as a native Resonant Notes workspace.",
  "health": {
    "strategy": "vault-bridge-ready"
  },
  "hooks": [
    {
      "event": "after-archive-intake",
      "failurePolicy": "warn",
      "handlerRef": "vault-index-preflight",
      "id": "after-vault-intake-index",
      "requiredCapabilities": [
        "filesystem"
      ]
    }
  ],
  "id": "addon.obsidian",
  "installHooks": {
    "onInstall": "bind-vault"
  },
  "name": "Resonant Notes",
  "provenance": {
    "signed": true,
    "signer": "ResonantOS bundled catalog",
    "tier": "bundled-core",
    "verificationState": "verified"
  },
  "providerRequirements": {
    "sharedProfiles": [],
    "supportsPrivateCredentials": false
  },
  "publisher": "local",
  "requestedCapabilities": [
    {
      "capability": "filesystem",
      "granted": false,
      "revocationBehavior": "hard-stop",
      "scope": "shared"
    },
    {
      "capability": "archive-read",
      "granted": false,
      "revocationBehavior": "degrade",
      "scope": "shared"
    },
    {
      "capability": "archive-intake-write",
      "granted": false,
      "revocationBehavior": "hard-stop",
      "scope": "intake-only"
    },
    {
      "capability": "ui-embedding",
      "granted": false,
      "revocationBehavior": "hide-surface",
      "scope": "system"
    }
  ],
  "runtimeIsolation": {
    "boundary": "shell-ui",
    "requiresReviewedGrant": true,
    "supportsDegradedMode": true
  },
  "runtimeType": "ui-module",
  "scripts": [
    {
      "commandRef": "obsidian.vault_index",
      "description": "Index markdown notes, tags, wikilinks, and backlinks before organization or intake work.",
      "deterministic": true,
      "id": "vault-index-preflight",
      "name": "Vault index preflight",
      "producesArtifacts": [
        "file-list",
        "diagnostic-report"
      ],
      "requiredCapabilities": [
        "filesystem"
      ],
      "requiresHumanApproval": false,
      "runPolicy": "preflight"
    }
  ],
  "sdkVersion": "^2.0.x",
  "skills": [
    {
      "description": "Help the human organize markdown notes with tags, wikilinks, and source boundaries while preserving review gates.",
      "documentPath": "docs/architecture/addon-skills/obsidian/VAULT_ORGANIZATION_ASSIST.md",
      "id": "vault-organization-assist",
      "invocation": "agent-suggested",
      "name": "Vault organization assist",
      "requiredCapabilities": [
        "filesystem",
        "archive-read",
        "archive-intake-write"
      ],
      "requiredTools": [
        "obsidian.vault_index",
        "obsidian.write_note"
      ]
    }
  ],
  "surfaces": [
    {
      "description": "Select, scan, and preview markdown notes from a user-approved vault.",
      "id": "obsidian-vault-bridge",
      "label": "Vault Bridge",
      "type": "panel"
    },
    {
      "description": "ResonantOS-hosted markdown workspace for operating an Obsidian-compatible vault.",
      "id": "obsidian-workspace",
      "label": "Resonant Notes Workspace",
      "type": "embedded-pane"
    }
  ],
  "tools": [
    {
      "audit": {
        "artifactTypes": [
          "log"
        ],
        "logRequest": true,
        "logResult": true
      },
      "description": "Write an existing markdown note through the host with stale-save protection, pre-write version snapshot, and audit record.",
      "inputSchema": {},
      "name": "obsidian.write_note",
      "outputSchema": {},
      "requiredCapabilities": [
        "filesystem"
      ],
      "requiresHumanApproval": true
    },
    {
      "audit": {
        "artifactTypes": [
          "log"
        ],
        "logRequest": true,
        "logResult": false
      },
      "description": "Build a clean-room Obsidian-compatible index of markdown notes, tags, wikilinks, backlinks, and search matches.",
      "inputSchema": {},
      "name": "obsidian.vault_index",
      "outputSchema": {},
      "requiredCapabilities": [
        "filesystem"
      ],
      "requiresHumanApproval": false
    }
  ],
  "version": "0.1.0",
  "workflowBoundaries": [
    {
      "id": "vault-as-human-workspace",
      "jobToBeDone": "Expose an Obsidian-compatible markdown vault as a user-managed knowledge workspace connected to Living Archive intake.",
      "label": "Vault as human workspace",
      "nonGoals": [
        "Force Obsidian as a core dependency",
        "Rewrite vault notes without approval",
        "Promote vault notes directly into trusted AI Memory pages"
      ],
      "owner": "human",
      "repeatability": "workflow-package",
      "userValue": "The human can keep editing notes in a familiar markdown/vault structure while ResonantOS tracks changes for memory intake."
    }
  ],
  "manifestSignature": {
    "algorithm": "ed25519",
    "publicKey": "{\"crv\":\"Ed25519\",\"x\":\"EsZYEa4u5S9MyBn5fiODyxmOnICG-8LuwoSDPFYwNhg\",\"kty\":\"OKP\"}",
    "signature": "cZA1BqSmfhDMt0fGbiI9ox5iixzt2ucqg75JmCSgRDAtLKtRO6YaPCs0EEmeMnoZA4wUZ4Q9NCmvFykIBofNBQ=="
  }
}
