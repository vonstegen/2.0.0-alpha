{
  "archiveIntegration": {
    "canRequestIngest": true,
    "canWriteKnowledgePages": false,
    "intakeWriteScopes": [
      "LivingArchive/INTAKE/browser"
    ],
    "readScopes": []
  },
  "author": "Resonant Alpha",
  "category": "tool",
  "compatibility": {
    "platforms": [
      "macOS",
      "linux",
      "windows"
    ],
    "shellVersion": "^2.0.0-beta.1"
  },
  "connectors": [
    {
      "configScope": "user-config",
      "description": "Host-mediated Chromium runtime used for visible browsing, page reads, interaction, and evidence capture.",
      "id": "controlled-chromium-host",
      "name": "Controlled Chromium host",
      "requiredCapabilities": [
        "network",
        "ui-embedding",
        "browser-control"
      ],
      "type": "local-runtime"
    }
  ],
  "delegation": {
    "acceptsTasks": true,
    "artifactReturnTypes": [
      "summary",
      "markdown",
      "log",
      "citation-bundle",
      "diagnostic-report"
    ],
    "defaultTargetRuntime": "local-service",
    "notes": [
      "Prefer API research for normal web lookup.",
      "Use browser delegation when visual inspection, login, forms, live page interaction, or web app testing are required.",
      "AI control must be routed through audited browser-session tools, not direct hidden DOM automation."
    ],
    "requiresHumanApprovalBeforeExecution": true,
    "taskTypes": [
      "research",
      "browser-inspection"
    ]
  },
  "description": "Chrome extension browser layer for side-panel web work, audited page context, and bridge-mediated AI control.",
  "grantPresets": [
    {
      "description": "Allows ResonantOS to use the Chrome extension surface and audited bridge-mediated browser tools.",
      "grants": [
        {
          "capability": "network",
          "granted": true,
          "revocationBehavior": "hard-stop",
          "scope": "shared"
        },
        {
          "capability": "ui-embedding",
          "granted": true,
          "revocationBehavior": "hide-surface",
          "scope": "system"
        },
        {
          "capability": "browser-control",
          "granted": true,
          "revocationBehavior": "hard-stop",
          "scope": "system"
        },
        {
          "capability": "filesystem",
          "granted": true,
          "revocationBehavior": "hard-stop",
          "scope": "shared"
        }
      ],
      "id": "browser-controlled-session",
      "label": "Browser extension session"
    }
  ],
  "health": {
    "strategy": "browser-first-bridge-status"
  },
  "hooks": [
    {
      "event": "before-task-complete",
      "failurePolicy": "block",
      "handlerRef": "browser-host-preflight",
      "id": "browser-task-completion-check",
      "requiredCapabilities": [
        "browser-control"
      ]
    }
  ],
  "id": "addon.browser",
  "installHooks": {
    "onInstall": "register-browser-surface"
  },
  "name": "Resonant Browser",
  "provenance": {
    "signed": true,
    "signer": "ResonantOS bundled catalog",
    "tier": "bundled-core",
    "verificationState": "verified"
  },
  "providerRequirements": {
    "sharedProfiles": [],
    "supportsPrivateCredentials": false
  },
  "publisher": "local",
  "requestedCapabilities": [
    {
      "capability": "network",
      "granted": false,
      "revocationBehavior": "hard-stop",
      "scope": "shared"
    },
    {
      "capability": "ui-embedding",
      "granted": false,
      "revocationBehavior": "hide-surface",
      "scope": "system"
    },
    {
      "capability": "browser-control",
      "granted": false,
      "revocationBehavior": "hard-stop",
      "scope": "system"
    },
    {
      "capability": "filesystem",
      "granted": false,
      "revocationBehavior": "hard-stop",
      "scope": "shared"
    },
    {
      "capability": "archive-intake-write",
      "granted": false,
      "revocationBehavior": "degrade",
      "scope": "intake-only"
    }
  ],
  "runtimeIsolation": {
    "boundary": "host-mediated-service",
    "requiresReviewedGrant": true,
    "supportsDegradedMode": true
  },
  "runtimeType": "local-service",
  "scripts": [
    {
      "commandRef": "browser.health",
      "description": "Verify that the native browser host and controlled Chromium runtime are reachable before a delegated browser task runs.",
      "deterministic": true,
      "id": "browser-host-preflight",
      "name": "Browser host preflight",
      "producesArtifacts": [
        "diagnostic-report"
      ],
      "requiredCapabilities": [
        "browser-control"
      ],
      "requiresHumanApproval": false,
      "runPolicy": "preflight"
    }
  ],
  "sdkVersion": "^2.0.x",
  "service": {
    "entrypoint": "browser-first/host/run-bridge-minimal.mjs",
    "healthCommand": "/status",
    "protocol": "http-json",
    "shutdownCommand": ""
  },
  "skills": [
    {
      "description": "Guide Augmentor through a browser task that needs visual inspection, login-aware context, form interaction, or evidence capture.",
      "documentPath": "docs/addons/browser/skills/browser-research-session.md",
      "id": "browser-research-session",
      "invocation": "agent-suggested",
      "name": "Browser-backed research session",
      "requiredCapabilities": [
        "network",
        "browser-control"
      ],
      "requiredTools": [
        "browser.open_url",
        "browser.read_page",
        "browser.capture_evidence"
      ]
    }
  ],
  "surfaces": [
    {
      "description": "Open the live Browser workspace inside the ResonantOS center column.",
      "id": "browser-pane",
      "label": "Browser",
      "type": "embedded-pane"
    }
  ],
