{
  "agents": [
    {
      "displayName": "OpenCode",
      "id": "opencode.runtime",
      "trustTier": "addon",
      "workspaceBehavior": "delegated"
    }
  ],
  "archiveIntegration": {
    "canRequestIngest": true,
    "canWriteKnowledgePages": false,
    "intakeWriteScopes": [
      "LivingArchive/INTAKE/coding"
    ],
    "readScopes": [
      "living-archive/context"
    ]
  },
  "augmentorSkills": [
    {
      "approvalGates": [
        "Human approval is required before OpenCode executes shell commands or broad filesystem work.",
        "OpenCode must return changed files, commands run, verification evidence, and residual risks before completion.",
        "Augmentor must not claim opencode.launch_workspace executed unless ResonantOS returns a concrete host result."
      ],
      "auditLogRequired": true,
      "documentPath": "docs/architecture/addon-skills/opencode/CODING_HANDOFF.md",
      "expectedInputs": [
        "human coding task",
        "workspace path or bounded files in scope"
      ],
      "expectedOutputs": [
        "delegation packet",
        "TASK.md",
        "diff",
        "file list",
        "command log",
        "verification report"
      ],
      "objective": "Delegate bounded coding, debugging, refactor, and coding-workspace diagnosis tasks to OpenCode under ResonantOS governance.",
      "producesDelegationPackets": true,
      "requiredCapabilities": [
        "filesystem",
        "shell",
        "providers",
        "ui-embedding"
      ],
      "requiredTools": [
        "opencode.launch_workspace"
      ],
      "workflowPhases": [
        "capture task scope",
        "create OpenCode delegation packet",
        "open scoped OpenCode workspace",
        "collect changed files and verification artifacts",
        "return result for human review"
      ]
    }
  ],
  "author": "Resonant Alpha",
  "category": "agent",
  "compatibility": {
    "platforms": [
      "macOS",
      "linux",
      "windows"
    ],
    "shellVersion": "^2.0.0-beta.1"
  },
  "connectors": [
    {
      "configScope": "user-config",
      "description": "Starts and embeds an OpenCode service for a selected local workspace.",
      "id": "opencode-local-service",
      "name": "OpenCode local service",
      "requiredCapabilities": [
        "filesystem",
        "shell",
        "ui-embedding"
      ],
      "type": "local-runtime"
    }
  ],
  "delegation": {
    "acceptsTasks": true,
    "artifactReturnTypes": [
      "summary",
      "diff",
      "file-list",
      "log",
      "diagnostic-report",
      "verification-report"
    ],
    "defaultTargetRuntime": "embedded-workspace",
    "notes": [
      "OpenCode must return changed files, commands run, verification evidence, and residual risks.",
      "Direct filesystem and process access must stay scoped to the task workspace."
    ],
    "requiresHumanApprovalBeforeExecution": true,
    "taskTypes": [
      "code-change",
      "bug-fix",
      "system-diagnosis"
    ]
  },
  "description": "Open-source coding workspace add-on. ResonantOS launches OpenCode as an optional scoped local service, embeds OpenCode's own web UI, and uses the server/API layer for governance and audit.",
  "extensionClass": "harness-provider",
  "harnessProvider": {
    "adapterProtocol": "http-json",
    "cancellationSemantics": "finish-atomic",
    "childActorPolicy": {
      "sandboxed": true,
      "workspace": true
    },
    "contextPolicy": {
      "bounded": true,
      "workspaceScoped": true
    },
    "eventContract": {
      "description": "Session progress and tool events.",
      "protocol": "opencode-events"
    },
    "resourceHints": {
      "cpu": "local",
      "network": "self"
    },
    "resultContract": {
      "description": "Final session result with artifacts.",
      "protocol": "opencode-result"
    },
    "sandboxStrength": "sandboxed-outer-boundary",
    "taskContract": {
      "description": "opencode serve session via HTTP/SSE.",
      "protocol": "opencode-session"
    }
  },
  "health": {
    "command": "opencode_status",
    "strategy": "workspace-process"
  },
  "hooks": [
    {
      "event": "before-task-complete",
      "failurePolicy": "block",
      "handlerRef": "opencode-workspace-preflight",
      "id": "opencode-before-task-complete",
      "requiredCapabilities": [
        "filesystem",
        "shell",
        "ui-embedding"
      ]
    }
  ],
  "id": "addon.opencode",
  "installHooks": {
    "onInstall": "register-coding-workspace"
  },
  "name": "OpenCode",
  "provenance": {
    "signed": true,
    "signer": "ResonantOS bundled catalog",
    "tier": "bundled-core",
    "verificationState": "verified"
  },
  "providerRequirements": {
    "fallbackPolicyId": "coding-default",
    "preferredRuntimeKinds": [
      "local",
      "remote-user-owned",
      "cloud"
    ],
    "sharedProfiles": [
      "gx10-local-llama",
      "shared-local",
      "shared-minimax"
    ],
    "supportsPrivateCredentials": true
  },
  "publisher": "local",
  "requestedCapabilities": [
    {
      "capability": "filesystem",
      "granted": false,
      "revocationBehavior": "hard-stop",
      "scope": "workspace"
    },
    {
      "capability": "shell",
      "granted": false,
      "revocationBehavior": "degrade",
      "scope": "workspace"
    },
    {
      "capability": "providers",
      "granted": false,
      "revocationBehavior": "degrade",
      "scope": "shared"
    },
    {
      "capability": "archive-read",
      "granted": false,
      "revocationBehavior": "degrade",
      "scope": "shared"
    },
    {
      "capability": "archive-intake-write",
      "granted": false,
      "revocationBehavior": "degrade",
      "scope": "intake-only"
    },
    {
      "capability": "ui-embedding",
      "granted": false,
      "revocationBehavior": "hide-surface",
      "scope": "system"
    }
  ],
  "runtimeIsolation": {
    "boundary": "shell-ui",
    "requiresReviewedGrant": true,
    "supportsDegradedMode": true
  },
  "runtimeType": "embedded-module",
  "scripts": [
    {
      "commandRef": "opencode.launch_workspace",
      "description": "Verify selected workspace path and service readiness before launching OpenCode.",
      "deterministic": true,
      "id": "opencode-workspace-preflight",
      "name": "OpenCode workspace preflight",
      "producesArtifacts": [
        "diagnostic-report",
        "verification-report"
      ],
      "requiredCapabilities": [
        "filesystem",
        "shell",
        "ui-embedding"
      ],
      "requiresHumanApproval": false,
      "runPolicy": "preflight"
    }
  ],
  "sdkVersion": "^2.0.x",
  "service": {
    "entrypoint": "opencode_start_service",
    "healthCommand": "opencode_status",
    "protocol": "host-command",
    "shutdownCommand": "opencode_stop_service"
  },
  "skills": [
    {
      "description": "Prepare task scope, workspace path, verification expectations, and artifact return rules for OpenCode.",
      "documentPath": "docs/architecture/addon-skills/opencode/CODING_HANDOFF.md",
      "id": "opencode-coding-handoff",
      "invocation": "agent-suggested",
      "name": "OpenCode coding handoff",
      "requiredCapabilities": [
        "filesystem",
        "shell",
        "providers",
        "archive-read"
      ],
      "requiredTools": [
        "opencode.launch_workspace"
      ]
    }
  ],
  "surfaces": [
    {
      "description": "Open a coding workspace inside the ResonantOS center surface.",
      "id": "opencode-workspace",
      "label": "OpenCode Workspace",
      "shellNavigation": {
        "dockIcon": "workspace",
        "eyebrow": "Coding workspace",
        "order": 30,
        "sectionId": "opencode"
      },
      "type": "embedded-pane"
    }
  ],
  "tools": [
    {
      "audit": {
        "artifactTypes": [
          "log",
          "diagnostic-report"
        ],
        "logRequest": true,
        "logResult": true
      },
      "description": "Start an OpenCode web/server session for a scoped workspace path.",
      "inputSchema": {},
      "name": "opencode.launch_workspace",
      "outputSchema": {},
      "requiredCapabilities": [
        "filesystem",
        "shell",
        "ui-embedding"
      ],
      "requiresHumanApproval": true
    }
  ],
  "version": "0.1.0",
  "workflowBoundaries": [
    {
      "id": "scoped-coding-workspace",
      "jobToBeDone": "Launch OpenCode as a scoped coding workspace with provider routing, filesystem boundaries, and artifact return.",
      "label": "Scoped coding workspace",
      "nonGoals": [
        "Grant unrestricted filesystem access",
        "Hide commands or changed files from the human",
        "Bypass deterministic verification before task completion"
      ],
      "owner": "addon-agent",
      "repeatability": "workflow-package",
      "userValue": "The human can use an open-source coding IDE under ResonantOS governance without broad shell or filesystem leakage."
    }
  ],
  "manifestSignature": {
    "algorithm": "ed25519",
    "publicKey": "{\"crv\":\"Ed25519\",\"x\":\"EsZYEa4u5S9MyBn5fiODyxmOnICG-8LuwoSDPFYwNhg\",\"kty\":\"OKP\"}",
    "signature": "/ZMg8EJsIpIOezFZTVf8vSifwNsslpyhZd0W1gmfj1E5pV0CSGiaoijWA9op/nKweMNIPma6Nee6cEOT4zc6BA=="
  }
}
