{
  "archiveIntegration": {
    "canRequestIngest": false,
    "canWriteKnowledgePages": false,
    "intakeWriteScopes": [],
    "readScopes": []
  },
  "author": "Resonant Alpha",
  "category": "agent",
  "compatibility": {
    "platforms": [
      "macOS",
      "linux",
      "windows"
    ],
    "shellVersion": "^2.0.0-beta.1"
  },
  "description": "Delegated cloud inference harness for DeepSeek's OpenAI-compatible API (Cordis kernel).",
  "extensionClass": "harness-provider",
  "harnessProvider": {
    "adapterProtocol": "http-json",
    "cancellationSemantics": "cancel",
    "childActorPolicy": {
      "cloud": true,
      "sandboxed": false
    },
    "contextPolicy": {
      "bounded": false,
      "stateless": true
    },
    "eventContract": {
      "description": "Streamed completion tokens with finish reason.",
      "protocol": "cordis-events"
    },
    "resourceHints": {
      "costTier": "paid-per-call",
      "cpu": "remote",
      "network": "self"
    },
    "resultContract": {
      "description": "Final completion plus token usage.",
      "protocol": "openai-completion"
    },
    "sandboxStrength": "host-mediated",
    "taskContract": {
      "description": "OpenAI-compatible chat request.",
      "protocol": "openai-chat-completions"
    }
  },
  "health": {
    "endpoint": "/api/v1/chat/completions",
    "strategy": "http-endpoint"
  },
  "id": "addon.deepseek-harness",
  "installHooks": {
    "onInstall": "register-cloud-inference-harness"
  },
  "name": "DeepSeek Harness",
  "provenance": {
    "signed": true,
    "signer": "ResonantOS bundled catalog",
    "tier": "bundled-core",
    "verificationState": "verified"
  },
  "providerRequirements": {
    "sharedProfiles": [
      "shared-deepseek"
    ],
    "supportsPrivateCredentials": true
  },
  "publisher": "local",
  "requestedCapabilities": [
    {
      "capability": "network",
      "granted": false,
      "revocationBehavior": "hard-stop",
      "scope": "self"
    },
    {
      "capability": "providers",
      "granted": false,
      "revocationBehavior": "hard-stop",
      "scope": "shared"
    },
    {
      "capability": "agent-delegation",
      "granted": false,
      "revocationBehavior": "degrade",
      "scope": "workspace"
    }
  ],
  "runtimeType": "agent-addon",
  "sdkVersion": "^2.0.x",
  "surfaces": [
    {
      "description": "Configure and monitor the local DeepSeek Harness service and the wrapped deepseek-chat / deepseek-reasoner models.",
      "id": "deepseek-harness-status",
      "label": "DeepSeek Harness",
      "shellNavigation": {
        "dockIcon": "harness",
        "eyebrow": "Agent runtime",
        "order": 40,
        "sectionId": "deepseek-harness"
      },
      "type": "panel"
    },
    {
      "description": "Track delegated DeepSeek reasoning runs and returned artifacts.",
      "id": "deepseek-harness-runs",
      "label": "DeepSeek Harness Runs",
      "type": "background-task-monitor"
    }
  ],
  "tools": [
    {
      "audit": {
        "artifactTypes": [
          "diagnostic-report"
        ],
        "logRequest": true,
        "logResult": true
      },
      "description": "Read DeepSeek Harness service health, current model, and queued runs.",
      "inputSchema": {},
      "name": "deepseek_harness.status",
      "outputSchema": {},
      "requiredCapabilities": [
        "network",
        "providers"
      ],
      "requiresHumanApproval": false
    },
    {
      "audit": {
        "artifactTypes": [
          "summary",
          "markdown",
          "log"
        ],
        "logRequest": true,
        "logResult": true
      },
      "description": "Run an approved Delegation Packet through DeepSeek Harness and return artifacts.",
      "inputSchema": {},
      "name": "deepseek_harness.run_task",
      "outputSchema": {},
      "requiredCapabilities": [
        "network",
        "providers",
        "agent-delegation"
      ],
      "requiresHumanApproval": true
    },
    {
      "audit": {
        "artifactTypes": [
          "log"
        ],
        "logRequest": true,
        "logResult": true
      },
      "description": "Cancel a queued or running DeepSeek Harness task by routing decision id.",
      "inputSchema": {},
      "name": "deepseek_harness.cancel",
      "outputSchema": {},
      "requiredCapabilities": [
        "network",
        "providers",
        "agent-delegation"
      ],
      "requiresHumanApproval": false
    }
  ],
  "version": "0.1.0",
  "manifestSignature": {
    "algorithm": "ed25519",
    "publicKey": "{\"crv\":\"Ed25519\",\"x\":\"EsZYEa4u5S9MyBn5fiODyxmOnICG-8LuwoSDPFYwNhg\",\"kty\":\"OKP\"}",
    "signature": "HDBw4qGn5ytC0hgVh4xMvWWai5jp77oVRCHlai3ZEIIdUX2+PUbz1lcDGweL9YfmncVPQhZghFiAk6tzgD+UCQ=="
  }
}
